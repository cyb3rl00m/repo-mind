{
  "manifest_version": 3,
  "name": "RepoMind",
  "short_name": "RepoMind",
  "version": "0.2.1",
  "description": "Local-first engineering intelligence for DeepSeek Web: repository indexing, context packages, impact analysis, patch review and local verification.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open RepoMind", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "nativeMessaging", "clipboardWrite"],
  "optional_permissions": ["notifications"],
  "host_permissions": ["https://api.github.com/*", "https://codeload.github.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.github.com https://codeload.github.com; worker-src 'self'"
  }
}
